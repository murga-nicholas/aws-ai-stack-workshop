# Offline runs need none of these. Real environment values win over .env.
# Live selection: --profile > AWS_PROFILE > CSV path > standard SDK chain.
AWS_PROFILE=
# IAM-console CSV; loaded in memory only when live execution is explicit.
AWS_CREDS_FILE_PATH=
# Region selection: --region > AWS_REGION > AWS_DEFAULT_REGION > us-east-1.
AWS_REGION=
AWS_DEFAULT_REGION=
# Standard AWS environment credentials (live only; never print these).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional pre-existing resources. The workshop never creates IAM roles.
AWSAI_HARNESS_ROLE_ARN=
AWSAI_GUARDRAIL_ID=
AWSAI_GUARDRAIL_VERSION=
AWSAI_REGISTRY_ID=
# Only a registered loopback collector is supported; tracing defaults off.
OTEL_EXPORTER_OTLP_ENDPOINT=
# LocalStack requires an auth token and the plan for the requested service.
LOCALSTACK_AUTH_TOKEN=
# Default: http://localhost:4566 (loopback only).
LOCALSTACK_ENDPOINT=
# Compose default: qwen2.5:0.5b; model downloads must be prepared separately.
DEFAULT_BEDROCK_MODEL=
# Used only by the explicit cross-vendor OpenAI provider, never by Bedrock.
OPENAI_API_KEY=
